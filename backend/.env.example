# ==========================================================

# SCANIX AI — CORE

# ==========================================================

PROJECT=SCANIX AI
APP_NAME=SCANIX AI
VERSION=1.0.0
PROJECT_MODE=nutrition

ENV=development
DEBUG=true
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

API_V1_PREFIX=/api/v1

APP_TIMEZONE=Asia/Kolkata

# ==========================================================

# SECURITY

# ==========================================================

SECRET_KEY=
JWT_SECRET=

JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

ALLOWED_HOSTS=*

API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000

ACCESS_TOKEN_TYPE=bearer
PASSWORD_HASH_ALGORITHM=bcrypt

# ==========================================================

# DATABASE (POSTGRESQL)

# ==========================================================

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/scanix_ai

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true

# ==========================================================

# CACHE / REDIS

# ==========================================================

REDIS_URL=redis://localhost:6379

CACHE_TTL=3600
SCAN_CACHE_TTL=86400

# ==========================================================

# AI PROVIDERS

# ==========================================================

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

ENABLE_GEMINI=true
ENABLE_GROQ=true
ENABLE_OPENROUTER=true

AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

AI_PROVIDER_STRATEGY=fallback
AI_PROVIDER_ORDER=gemini,groq,openrouter

AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3

AI_REQUESTS_PER_MINUTE=60
AI_REQUESTS_PER_DAY=5000

AI_MAX_INPUT_TOKENS=32000
AI_MAX_OUTPUT_TOKENS=4096

AI_ENABLE_FALLBACK=true
AI_ENABLE_CACHING=true

AI_CACHE_TTL_SECONDS=86400

# ==========================================================

# MODELS

# ==========================================================

DEFAULT_MODEL=gemini-2.5-flash

AI_PRIMARY_MODEL=gemini-2.5-flash
AI_DEEP_MODEL=gemini-2.5-flash

AI_EXPLAINER_MODEL=gemini-2.5-flash
AI_AGENT_MODEL=gemini-2.5-flash
AI_MEAL_MODEL=gemini-2.5-flash

# ==========================================================

# SYSTEM 1 — SCAN INTELLIGENCE

# ==========================================================

OPENFOODFACTS_URL=https://world.openfoodfacts.org

OPENFOODFACTS_TIMEOUT=10
OPENFOODFACTS_CACHE_TTL=86400
OPENFOODFACTS_USER_AGENT=Scanix-AI/1.0

ENABLE_OPENFOODFACTS=true

ENABLE_BARCODE_SCAN=true
ENABLE_CAMERA_SCAN=true
ENABLE_MANUAL_BARCODE_ENTRY=true

MAX_SCAN_IMAGES=4
MAX_UPLOAD_MB=10

SCAN_MAX_IMAGE_DIMENSION=4096

# ==========================================================

# OCR

# ==========================================================

OCR_PROVIDER=easyocr
OCR_FALLBACK=tesseract

OCR_MIN_CONFIDENCE=0.70
OCR_MAX_TEXT_LENGTH=25000

TESSERACT_PATH=

# ==========================================================

# SYSTEM 2 — INGREDIENT INTELLIGENCE

# ==========================================================

ENABLE_INGREDIENT_ANALYSIS=true

# ==========================================================

# SYSTEM 3 & 4 — USDA / METABOLIC / DIGITAL TWIN

# ==========================================================

USDA_API_KEY=

ENABLE_HEALTH_SCORING=true

HEALTH_SCORE_VERSION=1.0

# ==========================================================

# SYSTEM 5 — CONSUMER INTELLIGENCE

# ==========================================================

ENABLE_COMPLIANCE_ENGINE=true

# ==========================================================

# SYSTEM 6 — TRUST INTELLIGENCE

# ==========================================================

ENABLE_TRUST_WEB_SEARCH=true

# ==========================================================

# SYSTEM 7 — SMART FOOD INTELLIGENCE

# ==========================================================

ENABLE_PRODUCT_COMPARISON=true
RECOMMENDATION_VERSION=1.0

# ==========================================================

# SYSTEM 8 — AI HEALTH ASSISTANT

# ==========================================================

ENABLE_FOOD_EXPLAINER=true
ENABLE_NUTRITION_AGENT=true
ENABLE_MEAL_PLANNER=true
ENABLE_AGENT_MEMORY=true

# ==========================================================

# RESEARCH LAYER

# ==========================================================

PUBMED_EMAIL=

CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_MAILTO=

RAG_MAX_RESULTS=10
RAG_MAX_SOURCES=8

RAG_SEARCH_TIMEOUT=15
RAG_CACHE_TTL=86400

PUBMED_MAX_RESULTS=10
CROSSREF_MAX_RESULTS=10

# ==========================================================

# VECTOR DATABASE (QDRANT)

# ==========================================================

ENABLE_RAG=true

VECTOR_DB=qdrant

QDRANT_URL=
QDRANT_API_KEY=

QDRANT_COLLECTION=scanix_food
QDRANT_DISTANCE=cosine

# ==========================================================

# VOICE AI

# ==========================================================

ENABLE_VOICE_CHAT=true

VOICE_PROVIDER=edge
VOICE_MODE=normal

VOICE_LANGUAGE=en

VOICE_NAME=en-US-JennyNeural

VOICE_SPEED=1.0
VOICE_GENDER=female

VOICE_TIMEOUT=30

WHISPER_MODEL=small.en

# ==========================================================

# USER INTELLIGENCE

# ==========================================================

SCAN_HISTORY_LIMIT=100
FAVORITES_LIMIT=200

# ==========================================================

# STORAGE

# ==========================================================

UPLOAD_DIR=uploads
REPORTS_DIR=reports
CACHE_DIR=cache

MAX_FILE_SIZE_MB=10

ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# ==========================================================

# OBSERVABILITY

# ==========================================================

SENTRY_DSN=
POSTHOG_API_KEY=

# ==========================================================

# DEPLOYMENT

# ==========================================================

PROJECT_NAME=scanix-ai

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

CORS_ORIGINS=[http://localhost:3000,http://localhost:8000](http://localhost:3000,http://localhost:8000)

# ==========================================================

# BACKGROUND TASKS

# ==========================================================

CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# ==========================================================

# FUTURE INTEGRATIONS (OPTIONAL)

# ==========================================================

SPOONACULAR_API_KEY=

APININJAS_API_KEY=

FATSECRET_CLIENT_ID=
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

OPENFDA_URL=https://api.fda.gov
OPENFDA_ENABLED=true
